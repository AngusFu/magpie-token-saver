{
  "name": "magpie-token-saver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Magpie plugin: install, health-check, and quick links for bili / Headroom / RTK / gateway compress stack",
  "main": "./index.js",
  "bin": {
    "magpie-token-saver": "./cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AngusFu/magpie-token-saver.git"
  },
  "author": "Angus Fu",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "magpie": {
    "hooks": "./gateway-compress.hooks.mjs",
    "summary": "Gateway middleware + console for bili/RTK/Headroom (CC stays on :3425)",
    "options": {
      "enabled": true,
      "gatewayCompress": true,
      "minChars": 1200,
      "toolMaxChars": 12000,
      "headChars": 720,
      "tailChars": 360
    },
    "page": {
      "title": "Token Saver",
      "titles": {
        "zh": "Token Saver 控制台"
      },
      "file": "page/enter.html",
      "service": {
        "port": 48766,
        "option": "port"
      },
      "keepAlive": true
    }
  }
}
